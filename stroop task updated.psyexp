    <Routine name="fatigue_probe"/>
    <Routine name="practice_intro"/>
    <LoopInitiator loopType="TrialHandler" name="practice">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'word': 'red', 'colour': 'red', 'congruent': 1, 'corrAns': 'left'}, {'word': 'red', 'colour': 'green', 'congruent': 0, 'corrAns': 'down'}, {'word': 'green', 'colour': 'green', 'congruent': 1, 'corrAns': 'down'}, {'word': 'green', 'colour': 'blue', 'congruent': 0, 'corrAns': 'right'}, {'word': 'blue', 'colour': 'blue', 'congruent': 1, 'corrAns': 'right'}, {'word': 'blue', 'colour': 'red', 'congruent': 0, 'corrAns': 'left'}]" valType="str"/>
