        <Param val="console.log(&quot;PROBE  | count:&quot;, state[&quot;probe_count&quot;], &quot;| due:&quot;, state[&quot;probe_due&quot;]);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="print('PROBE  | count:', state['probe_count'],&amp;#10;      '| due:', state['probe_due'])" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if ((borg_slider.getRating() !== null)) {&amp;#10;    i = state[&quot;probe_count&quot;];&amp;#10;    psychoJS.experiment.addData(&quot;borg_cr100&quot;, borg_slider.getRating());&amp;#10;    psychoJS.experiment.addData(&quot;borg_rt&quot;, borg_slider.getRT());&amp;#10;    if ((i &lt; probe_labels.length)) {&amp;#10;        psychoJS.experiment.addData(&quot;probe_label&quot;, probe_labels[i]);&amp;#10;    } else {&amp;#10;        psychoJS.experiment.addData(&quot;probe_label&quot;, &quot;extra&quot;);&amp;#10;    }&amp;#10;    psychoJS.experiment.addData(&quot;probe_index&quot;, i);&amp;#10;    psychoJS.experiment.addData(&quot;probe_elapsed&quot;, (task_clock.getTime() - state[&quot;paused_time&quot;]));&amp;#10;    state[&quot;probe_count&quot;] = (i + 1);&amp;#10;    borg_slider.reset();&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="if borg_slider.getRating() is not None:&amp;#10;    i = state['probe_count']&amp;#10;&amp;#10;    thisExp.addData('borg_cr100', borg_slider.getRating())&amp;#10;    thisExp.addData('borg_rt', borg_slider.getRT())&amp;#10;&amp;#10;    if i &lt; len(probe_labels):&amp;#10;        thisExp.addData('probe_label', probe_labels[i])&amp;#10;    else:&amp;#10;        thisExp.addData('probe_label', 'extra')&amp;#10;&amp;#10;    thisExp.addData('probe_index', i)&amp;#10;    thisExp.addData('probe_elapsed', task_clock.getTime() - state['paused_time'])&amp;#10;&amp;#10;    state['probe_count'] = i + 1&amp;#10;    borg_slider.reset()" valType="extendedCode" updates="constant" name="End Routine"/>
